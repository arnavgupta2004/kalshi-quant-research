# Copy to .env (gitignored).  Public REST market data works WITHOUT any credentials.
# The WebSocket (all channels, including public ones) requires an API key.
# Create a key at https://kalshi.com/account/profile  -> "API Keys".
# A read-only research key is sufficient; this project never places orders.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem
# or inline instead of a path (newlines as \n):
# KALSHI_PRIVATE_KEY_PEM=

# prod (default) | demo
# KALSHI_ENV=prod
# KALSHI_REST_URL=
# KALSHI_WS_URL=
